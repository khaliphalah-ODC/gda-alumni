# Copy these NAMES into the Vercel backend project's Environment Variables.
# Replace every placeholder there. Do not commit real values or upload backend/.env.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DATABASE?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=1
# Generate a unique value with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_VALUE
JWT_EXPIRES_IN=7d
# The real/planned HTTPS frontend origin, with no path or /api suffix.
FRONTEND_ORIGIN=https://YOUR-FRONTEND.example
TRUST_PROXY_HOPS=1
RATE_LIMIT_STORAGE=database
# Generate another independent value with openssl rand -hex 48.
CRON_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_VALUE

# Gmail: create a Google app password after enabling 2-Step Verification.
ACTIVATION_DELIVERY=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=YOUR-ADDRESS@gmail.com
SMTP_USER=YOUR-ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD_WITHOUT_SPACES

# Vercel cannot retain local disk uploads. Cloudinary is optional until uploads are enabled.
MEDIA_STORAGE=cloudinary
# Leave room for multipart headers within Vercel's 4.5 MB request limit.
IMAGE_MAX_BYTES=4194304
# CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
# CLOUDINARY_API_KEY=YOUR_API_KEY
# CLOUDINARY_API_SECRET=YOUR_API_SECRET
# GROQ_API_KEY=YOUR_OPTIONAL_CHATBOT_KEY
