# Server-only example. Copy to .env, then configure your own database and secret.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://portal:local_password@localhost:5432/gda_aims
JWT_SECRET=replace-this-local-development-secret-with-a-random-value
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

# Explicit selection wins. If EMAIL_PROVIDER is unset, ACTIVATION_DELIVERY is used.
EMAIL_PROVIDER=development
ACTIVATION_DELIVERY=development

# Gmail for local delivery: set EMAIL_PROVIDER=smtp and uncomment all six entries.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=your-address@gmail.com
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-google-app-password

# Railway production: set EMAIL_PROVIDER=brevo and configure these privately.
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=registrar@your-verified-domain.example
# BREVO_SENDER_NAME=Gray D. Allison Alumni Portal

# Optional, explicitly designated recipient for the guarded email diagnostic.
# EMAIL_TEST_RECIPIENT=your-test-inbox@example.com

MEDIA_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=your-key
# CLOUDINARY_API_SECRET=your-secret
