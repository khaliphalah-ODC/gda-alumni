generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ALUMNI
  STUDENT
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  password              String
  role                  Role                    @default(ALUMNI)
  isActive              Boolean                 @default(true)
  sessionVersion        Int                     @default(0)
  staffProfile          StaffProfile?
  accountTokens         AccountToken[]
  auditRecords          AuditRecord[]
  uploadedKnowledge     AiKnowledgeDocument[] @relation("KnowledgeUploader")
  reviewedKnowledge     AiKnowledgeDocument[] @relation("KnowledgeReviewer")
  membershipApplication MembershipApplication?  @relation("MemberAccount")
  reviewedApplications  MembershipApplication[] @relation("ApplicationReviewer")
  membershipActions     MembershipReview[]
  studentProfile        StudentProfile?
  alumniProfile         AlumniProfile?
  posts                 Post[]
  requests              Request[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

enum RequestType {
  CERTIFICATE
  TRANSCRIPT
  DIPLOMA
  WAEC_CERTIFICATE
  WASSCE_CERTIFICATE
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  READY_FOR_PICKUP
  COMPLETED
}

model Request {
  version                Int           @default(0)
  id                     String        @id @default(cuid())
  requestType            RequestType
  purpose                String
  status                 RequestStatus @default(SUBMITTED)
  adminNote              String?
  requestedBy            String
  fullNameAtGraduation   String
  graduationYear         Int?
  studentIdOrIndexNumber String?
  contactPhone           String
  completedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user User @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([requestedBy])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}

enum PostType {
  ANNOUNCEMENT
  STORY
  EVENT
  HISTORY
  SCHOOL_LEADER
  ALUMNI_LEADER
  GALLERY
  ACHIEVEMENT
}

model Post {
  version       Int       @default(0)
  id            String    @id @default(cuid())
  title         String
  content       String
  image         String?
  category      String?
  imageAlt      String?
  imageCaption  String?
  imageWidth    Int?
  imageHeight   Int?
  summary       String?
  heading       String?
  sourceUrl     String?
  sourceLabel   String?
  legacyKey     String?   @unique
  type          PostType
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdBy     String
  eventDate     DateTime?
  eventTime     String?
  eventLocation String?
  audience      String?
  milestoneDate String?
  position      String?
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([isPublished])
  @@index([createdBy])
  @@index([publishedAt])
  @@index([type, isPublished, displayOrder])
  @@index([type, isPublished, category])
}

model AlumniProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String
  graduationYear Int?
  occupation     String?
  location       String?
  phone          String?
  bio            String?
  profileImage   String?
  profileImagePublicId String?
  imageVersion Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Historical records are retained; no student account routes are enabled.
enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

model StudentProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  fullName         String
  classLevel       String
  section          String?
  admissionYear    Int?
  guardianName     String?
  guardianPhone    String?
  enrollmentStatus EnrollmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentStatus])
}

enum ActivationDeliveryStatus {
  NONE
  DEVELOPMENT
  SENT
  FAILED
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipAction {
  SUBMITTED
  CORRECTED
  APPROVED
  REJECTED
  ACTIVATION_REISSUED
  ACTIVATION_REVOKED
  ACTIVATED
}

model MembershipApplication {
  id                       String                   @id @default(cuid())
  reference                String                   @unique
  trackingHash             String
  email                    String
  fullName                 String
  phone                    String
  location                 String?
  previousName             String?
  graduationYear           Int
  studentIndexNumber       String?
  lastClassAttended        String?
  verificationInformation  String?
  status                   MembershipStatus         @default(PENDING)
  rejectionReason          String?
  reviewedBy               String?
  reviewedAt               DateTime?
  activationDeliveryStatus ActivationDeliveryStatus @default(NONE)
  activationDeliveryAt     DateTime?
  activationHash           String?                  @unique
  activationExpiresAt      DateTime?
  activationConsumedAt     DateTime?
  activatedAt              DateTime?
  userId                   String?                  @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  reviewer                 User?                    @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  user                     User?                    @relation("MemberAccount", fields: [userId], references: [id], onDelete: Restrict)
  history                  MembershipReview[]

  @@index([email])
  @@index([status, createdAt])
}

model MembershipReview {
  id            String                @id @default(cuid())
  applicationId String
  actorId       String?
  action        MembershipAction
  notes         String?
  snapshot      Json?
  createdAt     DateTime              @default(now())
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User?                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

model StaffProfile {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  phone String?
  location String?
  profileImage String?
  profileImagePublicId String?
  imageVersion Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSettings {
  id Int @id @default(1)
  platformName String @default("Gray D. Allison Alumni Portal")
  emailEnabled Boolean @default(false)
  mediaEnabled Boolean @default(false)
  galleryManaged Boolean @default(false)
  achievementsManaged Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model AccountToken {
  id String @id @default(cuid())
  purpose String
  targetEmail String? @unique
  fullName String?
  userId String?
  sessionVersion Int?
  emailSnapshot String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String? @unique
  expiresAt DateTime
  consumedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}

model AuditRecord {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  targetId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model MediaCleanup {
  id String @id @default(cuid())
  publicId String @unique
  createdAt DateTime @default(now())
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  @@index([nextAttemptAt])
}

model RateLimitBucket {
  key String @id
  count Int
  resetAt DateTime
  @@index([resetAt])
}

// Public assistant configuration and anonymous aggregate quotas. No transcripts.
model ChatbotSettings {
  id Int @id @default(1)
  enabled Boolean @default(false)
  model String @default("openai/gpt-oss-20b")
  dailyRequests Int @default(100)
  dailyBudgetMicros Int @default(1000000)
  outputTokenLimit Int @default(1024)
  updatedAt DateTime @updatedAt
}

enum KnowledgeProcessingStatus {
  PROCESSING
  READY
  NEEDS_REVIEW
  OCR_REQUIRED
  FAILED
}

enum KnowledgeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  SUPERSEDED
}

model AiKnowledgeDocument {
  id String @id @default(cuid())
  title String
  description String @default("")
  category String
  originalFilename String
  originalBytes Bytes
  fileSize Int
  mimeType String @default("application/pdf")
  fileHash String
  processingStatus KnowledgeProcessingStatus @default(PROCESSING)
  approvalStatus KnowledgeApprovalStatus @default(PENDING)
  securityReviewed Boolean @default(false)
  publicOriginal Boolean @default(false)
  processingError String?
  warnings String[] @default([])
  pageCount Int @default(0)
  emptyPages Int[] @default([])
  edition Int @default(1)
  version Int @default(0)
  supersedesId String? @unique
  supersedesVersion Int?
  supersedes AiKnowledgeDocument? @relation("KnowledgeReplacement", fields: [supersedesId], references: [id], onDelete: SetNull)
  replacement AiKnowledgeDocument? @relation("KnowledgeReplacement")
  uploadedBy String
  reviewedBy String?
  reviewedAt DateTime?
  uploader User @relation("KnowledgeUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewer User? @relation("KnowledgeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  chunks AiKnowledgeChunk[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus, processingStatus])
  @@index([category, createdAt])
}

model AiKnowledgeChunk {
  id String @id @default(cuid())
  documentId String
  document AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text String
  pageNumber Int
  ordering Int
  edition Int
  @@unique([documentId, ordering])
}
model ChatbotFaq {
  id String @id @default(cuid())
  question String
  answer String
  path String
  published Boolean @default(false)
  validUntil DateTime
  version Int @default(0)
  updatedAt DateTime @updatedAt
}
model ChatbotUsage {
  day String @id
  requests Int @default(0)
  reservedMicros Int @default(0)
}
